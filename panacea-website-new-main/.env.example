# Copy to .env.local and set strong values before deploying.
ADMIN_PASSWORD=change-me-before-production
ADMIN_SESSION_SECRET=change-me-to-a-long-random-string
NEXT_PUBLIC_SITE_URL=https://www.panaceaitservices.com
CONTACT_TO_EMAIL=contact@panaceaitservices.com
# Optional: when set, /api/contact sends via Resend instead of mailto handoff
RESEND_API_KEY=
CONTACT_FROM_EMAIL=Panacea Website <onboarding@resend.dev>
